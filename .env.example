# Local development: copy this file to .env.local.
APP_URL=http://localhost:3000
MAIL_TRANSPORT=local

# Production: set these privately in Vercel; leave MAIL_TRANSPORT unset.
# Runtime: use the limited postito_runtime role, transaction pooler and sslmode=verify-full.
# Run migrations separately with an administrative connection; never commit either URL.
DATABASE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=postito-private
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Choose exactly one provider. Omit MAIL_PROVIDER to keep Resend.
# Brevo: verify the sender in the dashboard before enabling.
MAIL_PROVIDER=resend
BREVO_API_KEY=
# Plain verified email address, without a display name. The app uses "Postito".
BREVO_FROM_EMAIL=
