# Local development: copy this file to .env.local.
APP_URL=http://localhost:3000
MAIL_TRANSPORT=local

# Production: set these privately in Vercel; leave MAIL_TRANSPORT unset.
# Runtime: use the limited postito_runtime role, transaction pooler and sslmode=verify-full.
# Run migrations separately with an administrative connection; never commit either URL.
DATABASE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=postito-private
RESEND_API_KEY=
RESEND_FROM_EMAIL=
